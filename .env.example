# Скопируйте в .env и задайте ключ. Никогда не коммитьте .env.
# Обязательно: OpenAI или совместимый провайдер (тогда поменяйте OPENAI_BASE_URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_FAST=gpt-4.1-mini
MODEL_REASONING=gpt-4.1
MODEL_FALLBACK=
# dynamic: длинные диалоги переключаются на MODEL_REASONING; static: всегда MODEL_FAST.
MODEL_STRATEGY=dynamic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

DATA_DIR=./data
# Пусто = встроенный Qdrant в DATA_DIR/qdrant (один процесс). Compose задаёт свой сервер.
QDRANT_URL=
QDRANT_API_KEY=

# Доступ. Без токена API принимает запросы только с localhost.
APP_TOKEN=
# Или раздельные пользователи: {"long-token-a":"alice","long-token-b":"bob"}
APP_USERS_JSON=

# Необязательные инструменты: без ключа инструмент не предлагается модели.
TAVILY_API_KEY=
# Sandbox E2B: сгенерированный код никогда не выполняется на хосте.
E2B_API_KEY=

# Необязательный трекинг в Langfuse: включается, когда заданы оба ключа (Project Settings → API Keys).
# В trace попадает текст обращений и документов; маскируются только e-mail и секреты.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com, или адрес своего сервера.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Бюджет одной задачи.
MAX_MODEL_CALLS=16
MAX_TOOL_CALLS=30
MAX_TOTAL_TOKENS=48000
RUN_TIMEOUT_SECONDS=300
